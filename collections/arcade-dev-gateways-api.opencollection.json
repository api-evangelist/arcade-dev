              "placement": "header"
            }
          },
          "docs": "Checks whether a gateway slug is available for use"
        },
        {
          "info": {
            "name": "Get a Gateway",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.arcade.dev/v1/orgs/:org_id/projects/:project_id/gateways/:gateway_id",
